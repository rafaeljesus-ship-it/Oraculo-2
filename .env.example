# Copie este arquivo para .env (local) ou configure estas variaveis
# diretamente no painel do Render (Environment).

# --- Gemini (Google AI Studio) ---
# Pegue em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo recomendado para custo x qualidade. Ver README para alternativas.
GEMINI_MODEL=gemini-2.5-flash

# --- HubSpot ---
# Private App Token do HubSpot da Flash, com escopo de leitura em
# crm.objects.companies.read e crm.objects.deals.read (e contacts.read
# se formos usar dono/AM como contato).
HUBSPOT_PRIVATE_APP_TOKEN=

# --- Slack ---
# Bot Token do app do Slack criado para o Oraculo (comeca com xoxb-).
# Precisa do escopo chat:write.
SLACK_BOT_TOKEN=
# Segredo compartilhado que o passo de webhook do Slack Workflow Builder
# deve enviar no header X-Oraculo-Secret, para evitar chamadas de fora.
WEBHOOK_SHARED_SECRET=

# --- Pagina web (caminho alternativo ao Slack) ---
# Opcional. Se definida, a pagina em "/" exige esse codigo no campo
# "Codigo de acesso" antes de processar a consulta.
FRONTEND_ACCESS_CODE=

# --- Servidor ---
PORT=3000
